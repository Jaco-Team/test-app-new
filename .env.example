VK_CLIENT_SECRET=
VK_CLIENT_ID=

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Self-hosted Sentry, клиентский сайт. DSN публичный; auth token — только в CI.
NEXT_PUBLIC_SENTRY_DSN=https://0e7d8a795af83e2ad2ec447a2d1da9c6@sentry.jacochef.ru/4
SENTRY_ORG=sentry
SENTRY_PROJECT=jacofood-web
SENTRY_AUTH_TOKEN=
SENTRY_UPLOAD_SOURCEMAPS=false

NEXT_PUBLIC_SENTRY_CUSTOM_MONITORING_ENABLED=false
NEXT_PUBLIC_RECOMMENDATIONS_ENABLED=false
NEXT_PUBLIC_SBP_ENABLED=false

# Site API: legacy по умолчанию; для локального Laravel — http://localhost:8080/
NEXT_PUBLIC_SITE_API_BASE_URL=https://api2.jacochef.ru/site/public/index.php/
# Только SSR/Node. В Docker для Laravel на хосте: http://host.docker.internal:8080/
# Для общей Docker network можно указать http://laravel.test/
SITE_API_INTERNAL_BASE_URL=https://api2.jacochef.ru/site/public/index.php/

NEXT_PUBLIC_YANDEX_TOKEN_SUGGEST=''
NEXT_PUBLIC_YANDEX_TOKEN_MAP=''
NEXT_PUBLIC_YANDEX_TOKEN_FIREBASE=''

# Публичный ключ SmartCaptcha для входа. Серверный secret хранится только в API.
# GitHub Actions: Repository secret с тем же именем; изменение требует пересборки фронта.
NEXT_PUBLIC_SMARTCAPTCHA_SITE_KEY=

# NEXT_PUBLIC_YANDEX_IMG = 'https://yacdn.jacofood.ru/'
# NEXT_PUBLIC_VK_IMG = 'https://cdnimg.jacofood.ru/'
NEXT_PUBLIC_YANDEX_IMG = 'https://mainimg.jacofood.ru/'
NEXT_PUBLIC_VK_IMG = 'https://mainimg.jacofood.ru/'
NEXT_PUBLIC_YANDEX_STORAGE = 'https://topimg.jacofood.ru/'

# openssl rand -base64 32 в терминале для получения secret

TRACKING_API_ENDPOINT=https://jacofood.ru/backend/api/first-visit
# TRACKING_API_ENDPOINT=http://127.0.0.1:8000/api/first-visit
TRACKING_API_TOKEN=''

# Экспериментальная форма отзывов: маршрут /{city}/feedback-experiment
CLIENT_FEEDBACK_EXPERIMENT_ENABLED=false
CLIENT_FEEDBACK_EXPERIMENT_USE_MOCKS=true

# Отзыв о чистоте кафе по защищённой ссылке
CAFE_FEEDBACK_PAGE_ENABLED=false
NEXT_PUBLIC_CAFE_REVIEW_API_URL=https://api2.jacochef.ru/site/public/index.php/cafe_review
